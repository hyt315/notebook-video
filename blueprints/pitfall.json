{
 "$blueprint": "pitfall",
 "$about": "踩坑提醒：一个常见错误、为什么错、怎么避免",
 "$howto": "只改 <<…>> 里的内容（改完不许留下任何 <<）。不想要的镜可以删；想多讲一点可以复制一镜。layout 只能用 compose-story 认得的 13 个：statement / define / number / bars / compare / code / flow / list / quiz / custom / media / page / type，content 字段照本蓝图或其他蓝图里同 layout 的镜抄。直接跑 make-video 就是主路线；每镜的 $components 是改写成手写场景（逃生舱，见 references/scenes.md#handwritten-scenes）时该用的骨架与组件。",
 "title": "<<片名>>",
 "theme": "flat",
 "mode": "component",
 "subject_of_film": "<<主题物（至少在一镜 see 或 title 出现）>>",
 "protect": [],
 "$protect_note": "只填旁白 lines 里原样出现的词（不能放只出现在代码或画面里而旁白没念的词，否则 validate-semantic-breaks 判 P0）",
 "kicker": "<<4–8 字栏目名>>",
 "header": "<<短标题 / ENGLISH>>",
 "headerSub": "<<副标题>>",
 "glossary": {},
 "chapters": [
  {
   "title": "<<章 1：翻车现场>>",
   "role": "hook",
   "shots": [
    {
     "role": "hook",
     "layout": "code",
     "see": "<<本镜画面说明（须包含顶层 subject_of_film 主题物）>>",
     "$why": "钩子：先给出翻车的代码",
     "lines": [
      "<<这段代码看起来没问题>>",
      "<<但 {{出问题的那一段}} 会……>>"
     ],
     "content": {
      "title": "<<文件名>>",
      "lang": "<<语言>>",
      "code": "<<≤8 行有坑的代码>>"
     },
     "$components": {
      "skeleton": "Zoom",
      "components": [
       "DiffView",
       "Typewriter",
       "ConsoleWindow"
      ]
     },
     "$asks": "例：观众原本深信的直觉是什么，哪个反常事实或数字当场打脸？"
    }
   ]
  },
  {
   "title": "<<章 2：先懂一个词>>",
   "role": "pre",
   "shots": [
    {
     "role": "pre",
     "layout": "define",
     "$why": "预训练",
     "lines": [
      "<<先认识一个词：{{术语}}>>",
      "<<一句解释>>"
     ],
     "content": {
      "term": "<<术语>>",
      "definition": "<<定义>>",
      "example": "<<例：……>>"
     },
     "$components": {
      "skeleton": "Split",
      "components": [
       "FitTextBox",
       "Callout",
       "PillTag"
      ]
     },
     "$asks": "例：在拆开机制前，必须用一句大白话先说清哪个关键前提？"
    }
   ]
  },
  {
   "title": "<<章 3：为什么>>",
   "role": "breakdown",
   "shots": [
    {
     "role": "breakdown",
     "layout": "statement",
     "$why": "用字说清原因——这一镜通常不需要图",
     "lines": [
      "<<原因只有一句话：{{短语}}>>",
      "<<补充一句>>"
     ],
     "content": {
      "text": "<<原因（≤16 字）>>",
      "sub": "<<补充>>"
     },
     "$components": {
      "skeleton": "Stage",
      "components": [
       "Callout",
       "StampBanner",
       "FitTextBox"
      ]
     },
     "$asks": "例：去掉术语外壳，底层因果是哪一步推倒了哪一步？"
    },
    {
     "role": "example",
     "layout": "compare",
     "$why": "对照",
     "lines": [
      "<<错误写法>>",
      "<<{{正确写法}}……>>"
     ],
     "content": {
      "mode": "split",
      "before": {
       "title": "错误写法",
       "items": [
        "<<一句>>"
       ]
      },
      "after": {
       "title": "正确写法",
       "items": [
        "<<一句>>"
       ]
      },
      "afterLine": 1
     },
     "$components": {
      "skeleton": "Split",
      "components": [
       "SplitStage",
       "VerdictBar",
       "Checklist"
      ]
     },
     "$asks": "例：落到一个具体数字或真实场景里，效果究竟差多少？"
    }
   ]
  },
  {
   "title": "<<章 4：避坑>>",
   "role": "recap",
   "shots": [
    {
     "role": "misconception",
     "layout": "quiz",
     "$why": "可选",
     "lines": [
      "<<考考你：……？>>",
      "<<答案是 {{正确选项里的短语}}>>"
     ],
     "content": {
      "question": "<<问题？>>",
      "options": [
       "<<选项 A>>",
       "<<选项 B>>"
      ],
      "answer": 1,
      "think": 3
     },
     "$components": {
      "skeleton": "Zoom",
      "components": [
       "ChatThread",
       "SkeletonCard"
      ]
     },
     "$asks": "例：大家最容易信错的直觉和实际情况到底差在哪？"
    },
    {
     "role": "recap",
     "layout": "list",
     "$why": "收束",
     "lines": [
      "<<避坑清单：{{第一条}}>>",
      "<<{{第二条}}>>"
     ],
     "content": {
      "title": "避坑清单",
      "items": [
       "<<第一条>>",
       "<<第二条>>"
      ],
      "style": "check"
     },
     "$components": {
      "skeleton": "Split",
      "components": [
       "Checklist",
       "StaggerList"
      ]
     },
     "$asks": "例：回到开场问题，只用 ≤16 字让观众记住哪一句锤子句？"
    }
   ]
  }
 ]
}
