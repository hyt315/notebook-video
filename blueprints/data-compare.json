{
 "$blueprint": "data-compare",
 "$about": "数据对比：两组 / 多组数字说明一个结论",
 "$howto": "只改 <<…>> 里的内容（改完不许留下任何 <<）。不想要的镜可以删；想多讲一点可以复制一镜。layout 只能用 compose-story 认得的 13 个：statement / define / number / bars / compare / code / flow / list / quiz / custom / media / page / type，content 字段照本蓝图或其他蓝图里同 layout 的镜抄。直接跑 make-video 就是主路线；每镜的 $components 是改写成手写场景（逃生舱，见 references/scenes.md#handwritten-scenes）时该用的骨架与组件。",
 "title": "<<片名>>",
 "theme": "flat",
 "mode": "component",
 "subject_of_film": "<<主题物（至少在一镜 see 或 title 出现）>>",
 "protect": [],
 "$protect_note": "只填旁白 lines 里原样出现的词（不能放只出现在代码或画面里而旁白没念的词，否则 validate-semantic-breaks 判 P0）",
 "kicker": "<<4–8 字栏目名>>",
 "header": "<<短标题 / ENGLISH>>",
 "headerSub": "<<副标题>>",
 "glossary": {},
 "chapters": [
  {
   "title": "<<章 1：问题>>",
   "role": "hook",
   "shots": [
    {
     "role": "hook",
     "layout": "statement",
     "see": "<<本镜画面说明（须包含顶层 subject_of_film 主题物）>>",
     "$why": "钩子",
     "lines": [
      "<<一个问题，含 {{须与下方content文字一致的短语}}>>",
      "<<我们拿数据说话>>"
     ],
     "content": {
      "text": "<<屏上的问题（≤16 字）>>"
     },
     "$components": {
      "skeleton": "Stage",
      "components": [
       "Callout",
       "StampBanner",
       "FitTextBox"
      ]
     },
     "$asks": "例：观众原本深信的直觉是什么，哪个反常事实或数字当场打脸？"
    }
   ]
  },
  {
   "title": "<<章 2：怎么读图>>",
   "role": "pre",
   "shots": [
    {
     "role": "pre",
     "layout": "list",
     "$why": "预训练：先教观众怎么读这张图",
     "lines": [
      "<<先说怎么看：{{第一条}}>>",
      "<<{{第二条}}>>"
     ],
     "content": {
      "title": "<<读图要点>>",
      "items": [
       "<<第一条>>",
       "<<第二条>>"
      ],
      "style": "check"
     },
     "$components": {
      "skeleton": "Split",
      "components": [
       "Checklist",
       "StaggerList"
      ]
     },
     "$asks": "例：在拆开机制前，必须用一句大白话先说清哪个关键前提？"
    }
   ]
  },
  {
   "title": "<<章 3：数据>>",
   "role": "breakdown",
   "shots": [
    {
     "role": "breakdown",
     "layout": "bars",
     "$why": "一张图只讲一个结论",
     "lines": [
      "<<整体情况>>",
      "<<最突出的是 {{柱名}}>>"
     ],
     "content": {
      "title": "<<图表标题（单位）>>",
      "highlight": "<<柱名>>",
      "data": [
       {
        "label": "<<A>>",
        "value": 0
       },
       {
        "label": "<<B>>",
        "value": 0
       }
      ]
     },
     "$components": {
      "skeleton": "Stage",
      "components": [
       "BarChart",
       "StatRow"
      ]
     },
     "$asks": "例：去掉术语外壳，底层因果是哪一步推倒了哪一步？"
    },
    {
     "role": "example",
     "layout": "number",
     "$why": "把结论落成一个数字",
     "lines": [
      "<<关键差距 {{数字+单位}}>>",
      "<<这意味着……>>"
     ],
     "content": {
      "value": 0,
      "unit": "<<单位>>",
      "label": "<<一句话>>",
      "notes": [
       "<<补充>>"
      ]
     },
     "$components": {
      "skeleton": "Stage",
      "components": [
       "KineticNumber",
       "StatRow",
       "ProgressRing"
      ]
     },
     "$asks": "例：落到一个具体数字或真实场景里，效果究竟差多少？"
    }
   ]
  },
  {
   "title": "<<章 4：误区与回顾>>",
   "role": "recap",
   "shots": [
    {
     "role": "misconception",
     "layout": "compare",
     "$why": "误区",
     "lines": [
      "<<容易误读成……>>",
      "<<{{实际情况}}……>>"
     ],
     "content": {
      "mode": "split",
      "before": {
       "title": "容易误读",
       "items": [
        "<<误读>>"
       ]
      },
      "after": {
       "title": "实际情况",
       "items": [
        "<<正解>>"
       ]
      }
     },
     "$components": {
      "skeleton": "Split",
      "components": [
       "SplitStage",
       "VerdictBar",
       "Checklist"
      ]
     },
     "$asks": "例：大家最容易信错的直觉和实际情况到底差在哪？"
    },
    {
     "role": "recap",
     "layout": "statement",
     "$why": "收束",
     "lines": [
      "<<结论：{{短语}}>>",
      "<<一句建议>>"
     ],
     "content": {
      "text": "<<结论句>>",
      "sub": "<<建议>>",
      "subAt": 1
     },
     "$components": {
      "skeleton": "Stage",
      "components": [
       "Callout",
       "StampBanner",
       "FitTextBox"
      ]
     },
     "$asks": "例：回到开场问题，只用 ≤16 字让观众记住哪一句锤子句？"
    }
   ]
  }
 ]
}
