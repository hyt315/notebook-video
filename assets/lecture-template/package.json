    "@remotion/media": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/paths": "4.0.539",
    "@remotion/shapes": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "@shikijs/langs": "^4.5.0",
    "@visx/axis": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "budoux": "^0.9.2",
    "d3-dsv": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
