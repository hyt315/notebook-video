{
  "name": "notebook-video-visual-director-v9",
  "version": "3.3.0",
  "private": true,
  "description": "notebook-video lecture template: 16:9 Chinese teaching-video project (Remotion, flat / cel themes)",
  "scripts": {
    "sync": "node sync-render-inputs.cjs",
    "render": "npm run sync && remotion render src/index.tsx NotebookVideoFilm renders/notebook-video-visual-director.mp4 --codec=h264 --crf=16 --color-space=bt709 --concurrency=4",
    "still": "npm run sync && remotion still src/index.tsx NotebookVideoFilm renders/preview.png --frame=260",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cto.af/linebreak": "^4.0.3",
    "@remotion/cli": "4.0.539",
    "@remotion/effects": "4.0.539",
