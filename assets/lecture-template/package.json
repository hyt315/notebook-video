    "flubber": "^0.4.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.59.0",
    "opentype.js": "^2.0.0",
    "perfect-freehand": "^1.2.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "remotion": "4.0.539",
    "roughjs": "^4.6.6",
    "shiki": "^4.5.0",
    "simple-icons": "^16.35.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
